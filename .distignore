# Everything here is development-only and must not reach a release zip.
# `wp dist-archive .` reads this file.
.git
.gitignore
.github
.wordpress-org
.distignore
.wp-env.json
.wp-env.override.json
.phpunit.cache
.phpunit.result.cache
phpunit.xml.dist
phpunit.phar
phpunit-*.phar
tests

# Coding standards. All of it is development-only: the plugin has no runtime
# Composer dependencies, so vendor/ holds nothing but PHPCS and WPCS. It is
# listed because `wp dist-archive` reads the working directory rather than git,
# and an installed vendor/ would otherwise add several MB of linter to the zip.
composer.json
composer.lock
phpcs.xml.dist
.phpcs.cache
vendor

node_modules
README.md
.DS_Store
